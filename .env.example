# Obtenha API ID e API HASH em https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=sessions/main

# IDs que nunca devem entrar na lista de candidatos, separados por vírgula.
# Exemplo: EXCLUDED_USER_IDS=123456789,987654321
EXCLUDED_USER_IDS=

# IDs que são os únicos alvos permitidos para esta execução.
# DRY_RUN=false exige pelo menos um TARGET_USER_IDS.
# Exemplo: TARGET_USER_IDS=6879246100
TARGET_USER_IDS=

# Configuração segura para o primeiro teste.
MAX_INVITES_PER_RUN=5
MIN_DELAY_SECONDS=15
MAX_DELAY_SECONDS=30
DRY_RUN=true
